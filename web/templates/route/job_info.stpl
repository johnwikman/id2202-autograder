<% include!("../header.stpl"); %>

<h1>Job Information</h1>
<div class="table-responsive">
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th scope="col" style="white-space:nowrap">Submission ID</th>
        <th scope="col" style="white-space:nowrap">Date Submitted</th>
        <th scope="col" style="white-space:nowrap">Grading Tags</th>
        <th scope="col" style="white-space:nowrap">Status</th>
      </tr>
    </thead>
    <tbody>
<% for j in &job_info_vec { %>
      <tr>
          <td scope="row" style="white-space:nowrap"><%
            match &j.href {
              Some(href) => {
                %><a href="<%= href %>"><%= j.id.to_string() %></a><%
            },
              None => {
                %><%= j.id.to_string() %><%
            }
            } %></td>
          <td style="white-space:nowrap"><%= j.date_submitted %></td>
          <td><%
          for (i, t) in j.grading_tags.iter().enumerate() {
            %><code><%= t %></code><%
            if (i + 1) < j.grading_tags.len() {
              %>, <%
            }
          } %></td>
          <td style="white-space:nowrap"><%
            let (opt_symbol, opt_span_class) = &j.status_symbol_and_class;
            if let Some(symbol) = opt_symbol {
              %><%= symbol %> <%
            }
            match opt_span_class {
              Some(span_class) => {
                %><span class="<%= span_class %>"><%= j.status %></span><%
              },
              None => {
                %><%= j.status %><%
              }
            } %>
          </td>
      </tr>
<% } %>
    </tbody>
  </table>
</div>

<% include!("../footer.stpl"); %>
